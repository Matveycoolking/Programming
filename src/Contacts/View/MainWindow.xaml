<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="450" 
        Width="800"
        WindowStartupLocation="CenterScreen">

    <!-- Главный контейнер с отступами 15px со всех сторон -->
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <!-- Строка для заголовка -->
            <RowDefinition Height="Auto"/>
            <!-- Строка для двух колонок -->
            <RowDefinition Height="*"/>
            <!-- Строка для кнопок -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок окна -->

        <!-- Основная область с двумя колонками -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ КОЛОНКА - Edit Contact (с TextBox для ввода) -->
            <GroupBox Header="Edit Contact" 
                      Grid.Column="0"
                      Padding="10"
                      FontSize="16"
                      FontWeight="SemiBold">
                <StackPanel>
                    <!-- Поле Name -->
                    <TextBlock Text="Name:" 
                               FontSize="12" 
                               FontWeight="Normal"
                               Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" 
                             Height="25"
                             FontSize="12"
                             FontWeight="Normal"
                             Padding="5,0,0,0"/>

                    <!-- Поле Phone Number -->
                    <TextBlock Text="Phone Number:" 
                               FontSize="12" 
                               FontWeight="Normal"
                               Margin="0,0,0,3"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,10" 
                             Height="25"
                             FontSize="12"
                             FontWeight="Normal"
                             Padding="5,0,0,0"/>

                    <!-- Поле Email -->
                    <TextBlock Text="Email:" 
                               FontSize="12" 
                               FontWeight="Normal"
                               Margin="0,0,0,3"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,0" 
                             Height="25"
                             FontSize="12"
                             FontWeight="Normal"
                             Padding="5,0,0,0"/>
                </StackPanel>
            </GroupBox>

            <!-- Разделитель между колонками (пустое пространство шириной 10px) -->
            <Grid Grid.Column="1"/>

            <!-- ПРАВАЯ КОЛОНКА - Read Contact (с TextBlock для отображения) -->
            <GroupBox Header="Read Contact" 
                      Grid.Column="2"
                      Padding="10"
                      FontSize="16"
                      FontWeight="SemiBold">
                <StackPanel>
                    <!-- Поле Name (текст для отображения) -->
                    <TextBlock Text="Name:" 
                               FontSize="12" 
                               FontWeight="Normal"
                               Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Name}"
                               FontSize="12" 
                               FontWeight="Normal"
                               Height="25"
                               Margin="0,0,0,10"
                               Padding="5,5,0,0"
                               VerticalAlignment="Center"/>

                    <!-- Поле Phone Number (текст для отображения) -->
                    <TextBlock Text="Phone Number:" 
                               FontSize="12" 
                               FontWeight="Normal"
                               Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding PhoneNumber}"
                               FontSize="12" 
                               FontWeight="Normal"
                               Height="25"
                               Margin="0,0,0,10"
                               Padding="5,5,0,0"
                               VerticalAlignment="Center"/>

                    <!-- Поле Email (текст для отображения) -->
                    <TextBlock Text="Email:" 
                               FontSize="12" 
                               FontWeight="Normal"
                               Margin="0,0,0,3"/>
                    <TextBlock Text="{Binding Email}"
                               FontSize="12" 
                               FontWeight="Normal"
                               Height="25"
                               Margin="0,0,0,0"
                               Padding="5,5,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </GroupBox>
        </Grid>

        <!-- Панель с кнопками внизу - расположены под правой колонкой -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Пустая левая часть -->
            <Grid Grid.Column="0"/>

            <!-- Разделитель -->
            <Grid Grid.Column="1"/>

            <!-- Правая часть с кнопками -->
            <StackPanel Grid.Column="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="Save" 
                        Width="75" 
                        Height="25" 
                        Margin="3,0,3,0"
                        FontSize="12"
                        Command="{Binding SaveCommand}"/>
                <Button Content="Load" 
                        Width="75" 
                        Height="25" 
                        Margin="3,0,0,0"
                        FontSize="12"
                        Command="{Binding LoadCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>