<!-- MainWindow.xaml -->
<Window x:Class="ContactsSecond.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:View.Converters"
        mc:Ignorable="d"
        Title="Contacts" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        MinWidth="800" MinHeight="500">

    <Window.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Стиль для TextBox -->
        <Style x:Key="ContactTextBoxStyle" TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,15"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Height" Value="25"/>
            <Setter Property="BorderBrush" Value="#ccc"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Стиль для TextBlock заголовков -->
        <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,5,0,2"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#333"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель - список контактов -->
        <Grid Grid.Column="0" Background="#f8f8f8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Find: TextBox для поиска -->
            <StackPanel Grid.Row="1" Margin="10,0,10,10">
                <TextBlock Text="Find:" Margin="0,0,0,2" Foreground="#666"/>
                <TextBox x:Name="SearchTextBox" 
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Height="25" 
                         Padding="5"
                         BorderBrush="#ccc"
                         BorderThickness="1"/>
            </StackPanel>

            <!-- ListBox с контактами -->
            <ListBox Grid.Row="2" 
                     ItemsSource="{Binding FilteredContacts}"
                     SelectedItem="{Binding SelectedContact}"
                     Margin="10,0,10,10"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Name}" 
                                   Margin="2,3"
                                   FontSize="14"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Кнопки Add, Edit, Remove -->
            <StackPanel Grid.Row="3" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Center"
                        Margin="0,0,0,10">
                <Button Content="Add" 
                        Command="{Binding AddCommand}"
                        Width="60" Height="25" Margin="0,0,5,0"/>
                <Button Content="Edit" 
                        Command="{Binding EditCommand}"
                        Width="60" Height="25" Margin="5,0"/>
                <Button Content="Remove" 
                        Command="{Binding RemoveCommand}"
                        Width="60" Height="25" Margin="5,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1" 
                      Width="3" 
                      HorizontalAlignment="Stretch"
                      Background="White"/>

        <!-- Правая панель - детали контакта -->
        <ScrollViewer Grid.Column="2" 
                      Background="White"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Фото (слева) -->
                <Border Grid.Row="0" Grid.Column="0" 
                        Grid.RowSpan="3"
                        Width="100" Height="100"
                        BorderBrush="Gray" BorderThickness="1"
                        Margin="0,0,20,0"
                        VerticalAlignment="Top">
                    <TextBlock Text="Фото" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray"/>
                </Border>

                <!-- Поля ввода (справа от фото) -->
                <StackPanel Grid.Row="0" Grid.Column="1" 
                            Grid.RowSpan="3"
                            Margin="0,0,0,0">

                    <!-- Name -->
                    <TextBlock Text="Name:" 
                               Style="{StaticResource HeaderTextBlockStyle}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding AreFieldsReadOnly}"
                             Style="{StaticResource ContactTextBoxStyle}"
                             Width="300" HorizontalAlignment="Left"/>

                    <!-- Phone Number -->
                    <TextBlock Text="Phone Number:" 
                               Style="{StaticResource HeaderTextBlockStyle}"/>
                    <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding AreFieldsReadOnly}"
                             Style="{StaticResource ContactTextBoxStyle}"
                             Width="300" HorizontalAlignment="Left"/>

                    <!-- Email -->
                    <TextBlock Text="Email:" 
                               Style="{StaticResource HeaderTextBlockStyle}"/>
                    <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             IsReadOnly="{Binding AreFieldsReadOnly}"
                             Style="{StaticResource ContactTextBoxStyle}"
                             Width="300" HorizontalAlignment="Left"/>
                </StackPanel>

                <!-- Кнопка Apply (на отдельной строке, под фото и полями) -->
                <Button Grid.Row="3" Grid.Column="0" 
                        Grid.ColumnSpan="2"
                        Content="Apply"
                        Command="{Binding ApplyCommand}"
                        Width="75" Height="25"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        Visibility="{Binding IsApplyButtonVisible, Converter={StaticResource BoolToVisConverter}}"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>